Import('env')

# Add MuJoCo include headers
env.Append(CPPPATH=['#MuJoCo/include'])

# Add MuJoCo library linkage — pass the exact file node, bypassing
# SCons's auto prefix/suffix name resolution (which Godot overrides globally)
env.Append(LIBPATH=['#MuJoCo/lib'])
env.Append(LIBS=[File('#MuJoCo/lib/mujoco.lib')])

# List your module C++ source files here
sources = [
    "register_types.cpp",
    "mujoco_server.cpp",
]

module_env = env.Clone()
module_env.add_source_files(env.modules_sources, sources)